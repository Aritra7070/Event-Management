# Neon PostgreSQL — pooled connection string (postgresql://... with ?sslmode=require)
DATABASE_URL=

# Vercel Blob — read/write token from the Vercel dashboard
BLOB_READ_WRITE_TOKEN=

# Auth.js — random secret (openssl rand -base64 32)
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Canonical URL used in metadata and OG tags
NEXT_PUBLIC_APP_URL=http://localhost:3000
